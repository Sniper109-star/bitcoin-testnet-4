# RPC Connection to your testnet node
RPC_HOST=localhost
RPC_PORT=19001
RPC_USER=bitcoin
RPC_PASS=bitcoin

# Faucet Configuration
FAUCET_ADDRESS=your_faucet_address
FAUCET_PRIVATE_KEY=your_private_key

# Payout Settings
PAYOUT_AMOUNT=1             # 1 BTC per request
REQUEST_LIMIT=999999        # Unlimited
COOLDOWN_SECONDS=0          # No cooldown

# Server
PORT=5000
NODE_ENV=production